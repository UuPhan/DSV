-- Bảng phiên chat (1 user)
CREATE TABLE IF NOT EXISTS chat_session (
  chat_id        TEXT PRIMARY KEY,
  current_preset TEXT NOT NULL DEFAULT 'content_default',
  updated_at     TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Bảng preset
CREATE TABLE IF NOT EXISTS preset_store (
  preset_id             TEXT PRIMARY KEY,
  system_prompt_template TEXT NOT NULL,
  tool_whitelist        TEXT[] NOT NULL DEFAULT '{}',
  temperature           NUMERIC(3,2) NOT NULL DEFAULT 0.4,
  description           TEXT,
  updated_at            TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Bảng action chờ duyệt
CREATE TABLE IF NOT EXISTS pending_action (
  action_id    TEXT PRIMARY KEY,
  tool_name    TEXT NOT NULL,
  params       JSONB NOT NULL DEFAULT '{}'::jsonb,
  status       TEXT NOT NULL DEFAULT 'pending',  -- pending | confirmed | cancelled
  created_at   TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  confirmed_at TIMESTAMPTZ,
  cancelled_at TIMESTAMPTZ
);

CREATE INDEX IF NOT EXISTS idx_pending_action_status ON pending_action(status);

