    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Trích action block khỏi output của Agent Core\nconst out = $json.output || $json.text || '';\nconst m = out.match(/```action\\s*([\\s\\S]*?)```/);\nlet tool_name = '';\nlet params = {};\nif (m) {\n  try {\n    const parsed = JSON.parse(m[1].trim());\n    tool_name = parsed.tool_name || '';\n    params = parsed.params || {};\n  } catch (e) { /* ignore */ }\n}\nreturn {\n  agent_output: out,\n  tool_name,\n  params,\n  has_action: !!tool_name\n};"
      },
