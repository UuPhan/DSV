const input = $input.first().json;

const callback =
  $('Parse Callback').first()?.json || {};

// ============================================================
// Helpers
// ============================================================

function cleanString(value) {
  return String(value ?? '').trim();
}

function joinPath(...parts) {
  return parts
    .map((part, index) => {
      let value = String(part ?? '');

      if (index > 0) {
        value = value.replace(/^\/+/, '');
      }

      if (index < parts.length - 1) {
        value = value.replace(/\/+$/, '');
      }

      return value;
    })
    .filter(Boolean)
    .join('/');
}

function isAbsolutePath(value) {
  return (
    value.startsWith('/') ||
    /^[A-Za-z]:[\\/]/.test(value)
  );
}

function randomSeed() {
  return Math.floor(
    Math.random() * 4294967296
  );
}

function resolveArtifactPath(artifact, runDir) {
  const artifactPath =
    cleanString(artifact?.path);

  if (!artifactPath) {
    return null;
  }

  return isAbsolutePath(artifactPath)
    ? artifactPath
    : joinPath(runDir, artifactPath);
}

function findLatestArtifact(artifacts, predicate) {
  return [...artifacts]
    .filter(predicate)
    .sort(
      (a, b) =>
        Number(b.version || 0) -
        Number(a.version || 0)
    )[0] || null;
}

function findReferencedLyricsArtifact(
  artifacts,
  previewArtifact
) {
  const references =
    Array.isArray(previewArtifact?.reference)
      ? previewArtifact.reference
      : previewArtifact?.reference
        ? [previewArtifact.reference]
        : [];

  /*
   * reference now contains ONLY artifact paths.
   *
   * Example:
   *
   * [
   *   "/data/productions/run_xxx/run_xxx.lyrics.002.txt"
   * ]
   */

  for (const reference of references) {
    const referencePath =
      cleanString(reference);

    if (!referencePath) {
      continue;
    }

    const matched =
      artifacts.find(artifact => {
        if (
          !artifact ||
          artifact.name !== 'lyrics'
        ) {
          return false;
        }

        const artifactPath =
          cleanString(artifact.path);

        const artifactFilename =
          cleanString(artifact.filename);

        return (
          artifactPath === referencePath ||
          artifactFilename === referencePath ||
          referencePath.endsWith(
            `/${artifactFilename}`
          )
        );
      });

    if (matched) {
      return matched;
    }
  }

  return null;
}

// ============================================================
// Resolve action
// ============================================================

const action = cleanString(
  input.action ||
  callback.action ||
  input.callback_action ||
  callback.callback_action
);

if (!action) {
  throw new Error(
    'Prepare Minimax Music 3: missing action.'
  );
}

// ============================================================
// Resolve run_id
// ============================================================

const run_id = cleanString(
  input.run_id ||
  callback.run_id ||
  input.callback_run_id ||
  callback.callback_run_id
);

if (!run_id) {
  throw new Error(
    'Prepare Minimax Music 3: missing run_id.'
  );
}

if (
  run_id.includes('/') ||
  run_id.includes('\\') ||
  run_id.includes('..')
) {
  throw new Error(
    `Prepare Minimax Music 3: invalid run_id "${run_id}".`
  );
}

// ============================================================
// Resolve variant
// ============================================================

const variant = cleanString(
  input.variant ||
  callback.variant
);

if (!variant) {
  throw new Error(
    `Prepare Minimax Music 3: missing variant for run_id ${run_id}.`
  );
}

if (
  variant.includes('/') ||
  variant.includes('\\') ||
  variant.includes('..')
) {
  throw new Error(
    `Prepare Minimax Music 3: invalid variant "${variant}".`
  );
}

// ============================================================
// Resolve mode
// ============================================================

const modeRaw =
  input.mode ??
  callback.mode ??
  null;

const mode =
  modeRaw === null ||
  cleanString(modeRaw) === ''
    ? null
    : cleanString(modeRaw).toLowerCase();

// ============================================================
// Resolve max_duration
// ============================================================

const max_duration = Number(
  input.max_duration ??
  (mode === 'full' ? 170 : 30)
);

if (
  !Number.isFinite(max_duration) ||
  max_duration <= 0
) {
  throw new Error(
    `Prepare Minimax Music 3: invalid max_duration "${max_duration}".`
  );
}

// ============================================================
// Resolve callback artifact_version
// ============================================================

const artifactVersionRaw =
  input.artifact_version ??
  callback.artifact_version ??
  null;

let artifact_version = null;

if (
  artifactVersionRaw !== null &&
  cleanString(artifactVersionRaw) !== ''
) {
  const value =
    cleanString(artifactVersionRaw);

  if (!/^\d+$/.test(value)) {
    throw new Error(
      `Prepare Minimax Music 3: invalid artifact_version "${value}".`
    );
  }

  artifact_version = Number(value);

  if (
    !Number.isInteger(artifact_version) ||
    artifact_version <= 0
  ) {
    throw new Error(
      `Prepare Minimax Music 3: invalid artifact_version "${value}".`
    );
  }
}

// ============================================================
// Telegram callback caption
// ============================================================

const callback_caption = cleanString(
  callback.raw_callback_query?.message?.caption ||
  callback.message?.caption ||
  callback.callback_caption ||
  callback.telegram_caption ||
  input.raw_callback_query?.message?.caption ||
  input.callback_caption ||
  input.caption ||
  ''
);

// ============================================================
// Extract template filename from Telegram caption
//
// Used only as a fallback / diagnostic.
// FULL generation gets template from preview artifact.
// ============================================================

let callback_music_template_filename = null;

if (callback_caption) {
  const firstLine = callback_caption
    .split(/\r?\n/)
    .map(line => cleanString(line))
    .find(Boolean);

  if (firstLine) {
    callback_music_template_filename =
      firstLine;
  }
}

if (callback_music_template_filename) {
  if (
    callback_music_template_filename.includes('/') ||
    callback_music_template_filename.includes('\\') ||
    callback_music_template_filename.includes('..')
  ) {
    throw new Error(
      `Prepare Minimax Music 3: invalid callback music template filename "${callback_music_template_filename}".`
    );
  }
}

// ============================================================
// Production paths
// ============================================================

const productionRoot =
  cleanString(
    input.production_root ||
    input.run_root ||
    '/data/productions'
  );

const runDir = joinPath(
  productionRoot,
  run_id
);

const manifestPath = joinPath(
  runDir,
  `${run_id}.artifacts.json`
);

// ============================================================
// Read artifact manifest
// ============================================================

const fs = require('fs');

if (!fs.existsSync(manifestPath)) {
  throw new Error(
    `Prepare Minimax Music 3: artifact manifest not found: ${manifestPath}`
  );
}

let manifest;

try {
  manifest = JSON.parse(
    fs.readFileSync(
      manifestPath,
      'utf8'
    )
  );
} catch (error) {
  throw new Error(
    `Prepare Minimax Music 3: failed to read manifest ${manifestPath}: ${error.message}`
  );
}

if (
  !manifest ||
  !Array.isArray(manifest.artifacts)
) {
  throw new Error(
    `Prepare Minimax Music 3: invalid artifact manifest: ${manifestPath}`
  );
}

const artifacts =
  manifest.artifacts;

// ============================================================
// Find preview artifact for FULL
//
// FULL does NOT generate a new seed/template.
//
// It inherits both from the preview artifact.
// ============================================================

let previewArtifact = null;

if (
  action === 'generate_music' &&
  mode === 'full'
) {
  const previewArtifacts =
    artifacts.filter(artifact =>
      artifact &&
      artifact.name === 'audio' &&
      artifact.variant === variant &&
      artifact.mode === 'preview' &&
      artifact.path
    );

  /*
   * Prefer the preview whose template matches
   * the template shown by Telegram.
   *
   * This protects against selecting an unrelated
   * preview when multiple previews exist.
   */

  if (callback_music_template_filename) {
    previewArtifact =
      findLatestArtifact(
        previewArtifacts,
        artifact =>
          artifact.template_filename ===
          callback_music_template_filename
      );
  }

  /*
   * If no exact template match is found,
   * use the latest preview for this variant.
   */

  if (!previewArtifact) {
    previewArtifact =
      findLatestArtifact(
        previewArtifacts,
        () => true
      );
  }

  if (!previewArtifact) {
    throw new Error(
      `Prepare Minimax Music 3: no preview audio artifact found for full generation, variant "${variant}".`
    );
  }

  if (
    previewArtifact.seed === undefined ||
    previewArtifact.seed === null
  ) {
    throw new Error(
      `Prepare Minimax Music 3: preview audio artifact has no seed: ${previewArtifact.path}`
    );
  }

  if (
    !Number.isInteger(
      Number(previewArtifact.seed)
    )
  ) {
    throw new Error(
      `Prepare Minimax Music 3: invalid preview seed: ${previewArtifact.seed}`
    );
  }

  if (
    !cleanString(
      previewArtifact.template_filename
    )
  ) {
    throw new Error(
      `Prepare Minimax Music 3: preview audio artifact has no template_filename: ${previewArtifact.path}`
    );
  }
}

// ============================================================
// Find lyrics artifacts
//
// Lyrics are run-level artifacts.
// Do NOT filter by music variant.
// ============================================================

const lyricsArtifacts =
  artifacts.filter(
    artifact =>
      artifact &&
      artifact.name === 'lyrics' &&
      artifact.path
  );

if (!lyricsArtifacts.length) {
  throw new Error(
    `Prepare Minimax Music 3: no lyrics artifact found for run_id ${run_id}.`
  );
}

// ============================================================
// Select lyrics artifact
// ============================================================

let lyricsArtifact = null;

/*
 * FULL:
 *
 * Use the lyrics referenced by the preview artifact.
 *
 * This is the important lineage rule.
 */

if (
  previewArtifact
) {
  lyricsArtifact =
    findReferencedLyricsArtifact(
      artifacts,
      previewArtifact
    );

  if (!lyricsArtifact) {
    throw new Error(
      `Prepare Minimax Music 3: preview artifact does not reference a valid lyrics artifact: ${previewArtifact.path}`
    );
  }
}

/*
 * Other modes:
 *
 * artifact_version explicitly selects lyrics.
 * Otherwise latest lyrics.
 */

if (!lyricsArtifact) {
  if (artifact_version !== null) {
    lyricsArtifact =
      lyricsArtifacts.find(
        artifact =>
          Number(artifact.version) ===
          artifact_version
      ) || null;

    if (!lyricsArtifact) {
      throw new Error(
        `Prepare Minimax Music 3: lyrics artifact version ${artifact_version} not found for run_id ${run_id}.`
      );
    }
  } else {
    lyricsArtifact =
      findLatestArtifact(
        lyricsArtifacts,
        () => true
      );
  }
}

// ============================================================
// Resolve lyrics version
// ============================================================

const lyrics_version =
  Number(lyricsArtifact.version);

if (
  !Number.isInteger(lyrics_version) ||
  lyrics_version <= 0
) {
  throw new Error(
    'Prepare Minimax Music 3: invalid lyrics artifact version.'
  );
}

// ============================================================
// Resolve lyrics path
// ============================================================

const lyricsPath =
  resolveArtifactPath(
    lyricsArtifact,
    runDir
  );

if (!lyricsPath) {
  throw new Error(
    'Prepare Minimax Music 3: lyrics artifact has no path.'
  );
}

if (!fs.existsSync(lyricsPath)) {
  throw new Error(
    `Prepare Minimax Music 3: lyrics file not found: ${lyricsPath}`
  );
}

// ============================================================
// Read official lyrics
// ============================================================

let lyrics;

try {
  lyrics =
    fs
      .readFileSync(
        lyricsPath,
        'utf8'
      )
      .trim();
} catch (error) {
  throw new Error(
    `Prepare Minimax Music 3: failed to read lyrics ${lyricsPath}: ${error.message}`
  );
}

if (!lyrics) {
  throw new Error(
    `Prepare Minimax Music 3: lyrics file is empty: ${lyricsPath}`
  );
}

// ============================================================
// Extract title
// ============================================================

const lyricParts =
  lyrics.split(/\r?\n\r?\n/);

const title =
  cleanString(
    lyricParts.shift()
  );

if (!title) {
  throw new Error(
    'Prepare Minimax Music 3: unable to extract title from lyrics artifact.'
  );
}

// ============================================================
// Shared themes directory
// ============================================================

const themesRoot =
  joinPath(
    productionRoot,
    'themes'
  );

const themesDir =
  joinPath(
    themesRoot,
    variant
  );

if (!fs.existsSync(themesDir)) {
  throw new Error(
    `Prepare Minimax Music 3: theme directory not found: ${themesDir}`
  );
}

// ============================================================
// Read available templates
// ============================================================

const templateFiles =
  fs
    .readdirSync(themesDir)
    .filter(filename => {
      try {
        return fs.statSync(
          joinPath(
            themesDir,
            filename
          )
        ).isFile();
      } catch {
        return false;
      }
    })
    .filter(filename =>
      filename
        .toLowerCase()
        .endsWith('.txt')
    );

if (!templateFiles.length) {
  throw new Error(
    `Prepare Minimax Music 3: no .txt music templates found in ${themesDir}`
  );
}

// ============================================================
// Resolve template + seed
//
// FULL:
//   template = preview artifact
//   seed     = preview artifact
//
// REGENERATE:
//   template = random
//   seed     = random
//
// PREVIEW:
//   template = random
//   seed     = random
// ============================================================

let music_template_filename;
let seed;

if (
  action === 'generate_music' &&
  mode === 'full'
) {
  /*
   * ----------------------------------------------------------
   * FULL FROM PREVIEW
   * ----------------------------------------------------------
   */

  music_template_filename =
    cleanString(
      previewArtifact.template_filename
    );

  seed =
    Number(
      previewArtifact.seed
    );

  if (
    !templateFiles.includes(
      music_template_filename
    )
  ) {
    throw new Error(
      `Prepare Minimax Music 3: preview template not found in ${themesDir}: ${music_template_filename}`
    );
  }

  if (
    !Number.isInteger(seed) ||
    seed < 0 ||
    seed > 4294967295
  ) {
    throw new Error(
      `Prepare Minimax Music 3: invalid preview seed "${seed}".`
    );
  }

} else {
  /*
   * ----------------------------------------------------------
   * NEW / REGENERATE
   * ----------------------------------------------------------
   */

  const randomIndex =
    Math.floor(
      Math.random() *
      templateFiles.length
    );

  music_template_filename =
    templateFiles[randomIndex];

  seed =
    randomSeed();
}

// ============================================================
// Resolve selected template path
// ============================================================

const music_template_path =
  joinPath(
    themesDir,
    music_template_filename
  );

// ============================================================
// Read selected music template
// ============================================================

if (!fs.existsSync(music_template_path)) {
  throw new Error(
    `Prepare Minimax Music 3: music template file not found: ${music_template_path}`
  );
}

let musicTemplate;

try {
  musicTemplate =
    fs
      .readFileSync(
        music_template_path,
        'utf8'
      )
      .trim();
} catch (error) {
  throw new Error(
    `Prepare Minimax Music 3: failed to read music template ${music_template_path}: ${error.message}`
  );
}

if (!musicTemplate) {
  throw new Error(
    `Prepare Minimax Music 3: music template is empty: ${music_template_path}`
  );
}

// ============================================================
// Template status
// ============================================================

let callback_music_template_status =
  'no_telegram_caption';

if (callback_caption) {
  if (
    callback_music_template_filename
  ) {
    if (
      callback_music_template_filename ===
      music_template_filename
    ) {
      callback_music_template_status =
        'match';
    } else if (
      action === 'regenerate_music'
    ) {
      callback_music_template_status =
        'regenerate_random';
    } else if (
      action === 'generate_music' &&
      mode === 'full'
    ) {
      callback_music_template_status =
        'preview_artifact';
    } else {
      callback_music_template_status =
        'mismatch';
    }
  } else {
    callback_music_template_status =
      'no_template_filename';
  }
}

// ============================================================
// Return
// ============================================================

return [
  {
    json: {
      ...input,

      // ------------------------------------------------------
      // Callback
      // ------------------------------------------------------

      action,
      run_id,
      variant,
      mode,

      // ------------------------------------------------------
      // Generation
      // ------------------------------------------------------

      max_duration,
      seed,

      // ------------------------------------------------------
      // Lyrics
      // ------------------------------------------------------

      title,

      artifact_version:
        lyrics_version,

      lyrics_version,

      lyrics_variant:
        lyricsArtifact.variant ?? null,

      lyrics,

      lyrics_filename:
        lyricsArtifact.filename ||
        `${run_id}.lyrics.${String(lyrics_version).padStart(3, '0')}.txt`,

      lyrics_path:
        lyricsPath,

      // ------------------------------------------------------
      // Music template
      // ------------------------------------------------------

      caption:
        musicTemplate,

      music_template_filename,

      music_template_path,

      // ------------------------------------------------------
      // Preview lineage
      // ------------------------------------------------------

      preview_artifact_path:
        previewArtifact?.path ||
        null,

      preview_artifact_version:
        previewArtifact?.version ||
        null,

      preview_seed:
        previewArtifact?.seed ??
        null,

      preview_template_filename:
        previewArtifact?.template_filename ||
        null,

      // ------------------------------------------------------
      // Callback diagnostics
      // ------------------------------------------------------

      callback_caption,

      callback_music_template_filename,

      callback_music_template_status
    }
  }
];
